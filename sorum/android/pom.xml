<!-- 빌드 도구 목록. build.sh가 Maven으로 이 부품들을 내려받아요. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
<groupId>local</groupId><artifactId>sorum-build-tools</artifactId><version>1</version>
<dependencies>
<!-- aapt2(리소스 링커)와 안드로이드 프레임워크 정의가 들어 있어요 -->
<dependency><groupId>org.apktool</groupId><artifactId>apktool-lib</artifactId><version>2.12.1</version>
 <exclusions><exclusion><groupId>com.android.tools.smali</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
<!-- smali: 사람이 읽는 어셈블리 코드를 안드로이드 실행파일(classes.dex)로 바꿔요 -->
<dependency><groupId>org.smali</groupId><artifactId>smali</artifactId><version>2.5.2</version></dependency>
<!-- apksig: APK에 서명해요 -->
<dependency><groupId>com.android.tools.build</groupId><artifactId>apksig</artifactId><version>2.3.0</version></dependency>
</dependencies></project>
